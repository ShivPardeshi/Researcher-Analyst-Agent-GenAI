# =======================================================
# Research Analyst Agents Configuration Environment Variables
# Copy this file to .env and configure your credentials
# =======================================================

# Model Provider: "google" (recommended) or "groq"
MODEL_PROVIDER=google

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API Key (Get key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Server Configuration
HOST=0.0.0.0
PORT=8000
REQUEST_TIMEOUT=90
